# --- build / packaging ---
build/
dist/
*.egg-info/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/

# --- notebooks ---
notebooks/*.pdf
notebooks/*.png
notebooks/*.xyz
notebooks/*.csv

# --- examples (notebooks / images) ---
examples/**/*.ipynb
examples/**/*.png

# --- examples (generated data / runs) ---
examples/swiss_ai/README.md
examples/swiss_ai/clusters.ipynb
examples/swiss_ai/data
examples/swiss_ai/db_out.db
examples/swiss_ai/run.py
examples/swiss_ai/run_one_metal.py
examples/swiss_ai/utils.py
examples/**/bkp/
examples/**/MD_statistics/
examples/**/*.xyz
examples/**/*.db
examples/**/*.json

# HPC job outputs and logs
examples/**/slurm-*.out
examples/**/log.txt

# ASE simulation outputs (results, not inputs)
examples/**/*.traj
examples/**/relaxed_*.xyz
examples/**/grd_top*.xyz
examples/**/grd_top*_naked.xyz

# keep scripts and input structures
!examples/**/*.py
!examples/**/*.sh
!examples/**/README.md

# --- temp / scratch ---
tmp.xyz
*.tmp
*.bak
*.swp

# --- data / meshes ---
*.xyz
*.ply
*.db
*.model

# --- editor / OS ---
.DS_Store
.vscode/
.idea/

